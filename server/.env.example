# Keep secrets in the VPS Secret/env file; do not commit actual values.

# --- Third-party providers (YouTube) ---
VIDFETCH_API_KEY=
SNAPANY_API_KEY=

# --- Daily download quota (browser + IP, UTC reset) ---
VIDSAVEY_QUOTA_SECRET=replace-with-a-random-minimum-32-character-secret
VIDEO_DAILY_LIMIT=2
DAILY_LIMIT_TIMEZONE=UTC
VIDEO_QUOTA_DB=/data/download_quota.sqlite3

# --- Provider routing ---
YOUTUBE_PROVIDER=vidfetch_then_snapany
YOUTUBE_PROVIDER_FALLBACK_ENABLED=true
YOUTUBE_PROVIDER_MAX_RETRIES=1
# Stop automatic fallback if upstream VidFetch is still processing/uncertain.
# Only automatically fallback on definitive failures and rejected submissions.

# --- Cost protection (leave empty to disable a cap; amounts in USD) ---
YOUTUBE_DAILY_COST_LIMIT_USD=
YOUTUBE_MONTHLY_COST_LIMIT_USD=
SNAPANY_DAILY_CALL_LIMIT=
BUDGET_DB=/data/provider_budget.sqlite3
